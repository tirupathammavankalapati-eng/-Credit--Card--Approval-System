# Flask secret key (change this to a random string in production)
SECRET_KEY=your-super-secret-key-change-this-in-production

# Database URL (default is SQLite, you can change to PostgreSQL/MySQL)
DATABASE_URL=sqlite:///instance/approval.db

# Path to the trained ML model
MODEL_PATH=models/model_pipeline.pkl

# Path to the dataset
DATA_PATH=data/credit_card_dataset.csv

# Prediction threshold (0.5 = balanced, lower = more approvals, higher = stricter)
THRESHOLD=0.5